# Browser-safe Supabase project URL and anon/publishable key (never a service-role key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server-only PostgreSQL connection. Percent-encode the database password.
# Use your project's connection settings; the transaction pooler suits Vercel.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=verify-full

# Optional: PEM CA certificate for a hosted database when a local certificate
# file is unavailable. Keep certificate verification enabled. See docs/INSTALL.md.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nYOUR_CA_CERTIFICATE\n-----END CERTIFICATE-----"

# Optional: only for a SEPARATE fresh demo project installed with db:setup:demo.
# Normal personal installations leave these unset. See docs/DEMO_HOSTING.md.
# FINANCE_DEMO_MODE=true
# DEMO_TURNSTILE_SITE_KEY=YOUR_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY
# Optional Google Analytics measurement ID for the demo only; leave unset to disable.
# DEMO_GOOGLE_ANALYTICS_ID=G-YOUR_MEASUREMENT_ID
