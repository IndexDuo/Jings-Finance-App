# LOCAL, disposable Supabase services only. Never use your normal app database.
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=YOUR_LOCAL_ANON_KEY
E2E_SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_TEST_SERVICE_ROLE_KEY
E2E_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:54322/postgres
E2E_USER_EMAIL=finance-test@example.test
E2E_USER_PASSWORD=YOUR_FICTIONAL_TEST_PASSWORD_AT_LEAST_8_CHARACTERS
E2E_ALLOW_DATA_RESET=finance-app-e2e-only
# Optional local Mailpit inbox enables the complete signup/reset email flow test.
E2E_MAILPIT_URL=http://127.0.0.1:54324
# Optional when using an existing system Chromium instead of Playwright's download:
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chromium
